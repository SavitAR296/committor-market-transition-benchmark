manuscript:
	$(M) $(TEX) supplement.tex >/dev/null && $(PY) ../reproducibility_pre/$(S)/sync_labels.py && $(TEX) main.tex >/dev/null && $(TEX) main.tex >/dev/null && $(PY) ../reproducibility_pre/$(S)/sync_labels.py && $(TEX) main.tex >/dev/null && $(TEX) supplement.tex >/dev/null && $(TEX) supplement.tex >/dev/null && $(TEX) cover_letter.tex >/dev/null
